{
  "schema_version": 1,
  "name": "prompt-model-sweep",
  "target": {
    "node_id": "replace-with-owner-node-id"
  },
  "workspace": {
    "project_id": "replace-with-project-id",
    "mode": "worktree",
    "base_ref": "HEAD"
  },
  "matrix": {
    "prompt": [
      "Improve error handling in the selected project and document your changes.",
      "Inspect failure paths in the selected project, improve them, and verify your changes."
    ],
    "model": [
      "provider/model-a",
      "provider/model-b"
    ],
    "runtime.max_turns": [
      10,
      20
    ]
  },
  "context": {
    "mode": "fresh"
  },
  "limits": {
    "max_concurrent_runs": 2,
    "max_total_runs": 8,
    "max_child_tasks_per_run": 4
  },
  "budget": {
    "max_model_requests_per_run": 20,
    "max_tool_invocations_per_run": 50
  }
}
